<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.panduoma.trevaljava.mapper.UserMapper">
    <!-- ============ 结果映射 ============ -->
    <resultMap id="BaseResultMap" type="com.panduoma.trevaljava.entity.User">
            <id property="id" column="id" />
            <result property="username" column="username" />
            <result property="password" column="password" />
            <result property="phone" column="phone" />
            <result property="email" column="email" />
            <result property="avatar" column="avatar" />
            <result property="status" column="status" />
            <result property="createTime" column="create_time" />
    </resultMap>
    <!-- ============ 基础字段列表 ============ -->
    <sql id="Base_Column_List">
        id,username,password,phone,email,avatar,
        status,create_time
    </sql>
    <!--注册插入用户信息-->
    <insert id="insertSelective" keyColumn="id" keyProperty="id" parameterType="com.panduoma.trevaljava.entity.User" useGeneratedKeys="true">
        insert into user
        <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="username != null">username,</if>
                <if test="password != null">password,</if>
                <if test="phone != null">phone,</if>
                <if test="email != null">email,</if>
                <if test="avatar != null">avatar,</if>
                <if test="status != null">status,</if>
                <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                <if test="username != null">#{username},</if>
                <if test="password != null">#{password},</if>
                <if test="phone != null">#{phone},</if>
                <if test="email != null">#{email},</if>
                <if test="avatar != null">#{avatar},</if>
                <if test="status != null">#{status},</if>
                <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>
    <!-- 全字段插入 -->
    <insert id="insert" keyColumn="id" keyProperty="id"
            parameterType="com.panduoma.trevaljava.entity.User" useGeneratedKeys="true">
        insert into user (username, password, phone, email, avatar, status, create_time)
        values (#{username}, #{password}, #{phone}, #{email}, #{avatar}, #{status}, #{deleted}, #{createTime}, #{updateTime})
    </insert>
    <!-- ============ 删除操作 ============ -->

    <!-- 物理删除（慎用） -->
    <delete id="deleteByPrimaryKey" parameterType="java.lang.Long">
        delete from user where id = #{id}
    </delete>



    <!-- 选择性更新（只更新非null字段） -->
    <update id="updateByPrimaryKeySelective" parameterType="com.panduoma.trevaljava.entity.User">
        update user
        <set>
                <if test="username != null">username = #{username},</if>
                <if test="password != null">password = #{password},</if>
                <if test="phone != null">phone = #{phone},</if>
                <if test="email != null">email = #{email},</if>
                <if test="avatar != null">avatar = #{avatar},</if>
                <if test="status != null">status = #{status},</if>
                <if test="createTime != null">create_time = #{createTime},</if>
        </set>
        where   id = #{id} 
    </update>

    <!-- 全字段覆盖更新 -->
    <update id="updateByPrimaryKey" parameterType="com.panduoma.trevaljava.entity.User">
        update user
        set 
            username =  #{username},
            password =  #{password},
            phone =  #{phone},
            email =  #{email},
            avatar =  #{avatar},
            status =  #{status},
            create_time =  #{createTime}
        where   id = #{id} 
    </update>
    <!-- 根据id查询 -->
    <select id="selectByPrimaryKey" parameterType="java.lang.Long" resultMap="BaseResultMap">
        select <include refid="Base_Column_List" />
        from user
        where  id = #{id}
    </select>
    <!-- 查询所有未删除的正常用户 -->
    <select id="selectAllValidUser" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from user
        where deleted = 0 and status = 1
        order by create_time desc
    </select>
    <!-- 根据用户名查询用户，用于注册判断账号是否存在 -->
    <select id="selectByUsername" parameterType="String" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from user
        where username = #{username} and deleted = 0
    </select>
    <!-- 根据邮箱查询用户 -->
    <select id="selectByEmail" parameterType="String" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from user
        where email = #{email} and deleted = 0
    </select>

    <!-- 根据手机号查询用户 -->
    <select id="selectByPhone" parameterType="String" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from user
        where phone = #{phone} and deleted = 0
    </select>



</mapper>
